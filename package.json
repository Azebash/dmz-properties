{
  "name": "dmz-properties",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "test:live-workflows": "node --env-file=.env.local scripts/verify-live-admin-workflows.mjs",
    "test:live-staff-workflows": "node --env-file=.env.local scripts/verify-live-admin-workflows.mjs --staff-governance",
    "test:linked-staff:governance": "node --env-file=.env.local scripts/verify-local-staff-governance.mjs",
    "test:linked-public-property": "node --env-file=.env.local scripts/verify-local-property-publication.mjs",
    "test:linked-property-media": "node --env-file=.env.local scripts/verify-local-property-media.mjs",
    "test:linked-property-documents": "node --env-file=.env.local scripts/verify-property-documents.mjs",
    "test:live-property-documents": "node --env-file=.env.local scripts/verify-property-documents.mjs --production",
    "test:live-property-media": "node --env-file=.env.local scripts/verify-local-property-media.mjs --production",
    "test:linked-media-concurrency": "node --env-file=.env.local scripts/verify-linked-media-concurrency.mjs",
    "test:live-public-forms": "node --env-file=.env.local scripts/verify-live-public-forms.mjs",
    "test:live-published-property": "node --env-file=.env.local scripts/verify-live-published-property.mjs",
    "monitor:production": "node scripts/check-production-availability.mjs",
    "test:live-editorial": "node --env-file=.env.local scripts/verify-live-editorial-workflow.mjs",
    "test:live-estate-updates": "node --env-file=.env.local scripts/verify-live-editorial-workflow.mjs --estate-update",
    "test:live-area-guide": "node --env-file=.env.local scripts/verify-live-area-guide.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:test:linked": "node --env-file=.env.local scripts/run-linked-pgtap.mjs",
    "supabase:push:linked:pooler": "node --env-file=.env.local scripts/push-linked-pooler.mjs",
    "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postgres": "^3.4.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
