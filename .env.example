# Public site URL used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=

# Keep false until legal, content, inventory, and production checks are approved.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Supabase operational platform and staff authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PERSIST_ENQUIRIES=false

# Article and area-guide source remains repository-backed until the seeded
# Supabase publication path is verified. Switch to `database` after rollout.
SUPABASE_CONTENT_SOURCE=repository

# Local linked migration and pgTAP access via the Supabase connection pooler.
SUPABASE_DB_PASSWORD=

# Resend configuration for the secure enquiry endpoint.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=DMZ Properties <enquiries@your-verified-domain.com>

# Optional Google Analytics measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Optional production abuse protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional distributed rate limiting for serverless production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
